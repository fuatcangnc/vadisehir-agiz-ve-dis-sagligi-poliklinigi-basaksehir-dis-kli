---
import { ArrowRight, Phone } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import { href, localePaths, localized, locales, phoneHref, settings, siteText, whatsappHref } from '@/lib/i18n'

export const getStaticPaths = localePaths

const { locale } = Astro.props
const t = await siteText(locale)
const s = await settings()
const services = (await localized('services', locale)).sort((a, b) => a.data.order - b.data.order)
---

<Layout locale={locale} title={t.nav.services} description={t.services.intro} translated={await locales()}>
  <main>
    <section class="border-b border-neutral-200 bg-white py-14 lg:py-20">
      <div class="shell">
        <div class="inline-block -skew-x-12 bg-neutral-950 px-5 py-1.5">
          <span class="inline-block skew-x-12 text-xs font-black uppercase tracking-[0.2em] text-white">{t.nav.services}</span>
        </div>
        <h1 class="mt-5 max-w-3xl text-3xl font-black uppercase leading-tight tracking-tight text-neutral-950 sm:text-4xl lg:text-5xl">
          <bdi>{s.brand}</bdi> <span class="text-primary">{services.length} {t.services.count}</span>
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base">{t.services.intro}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={whatsappHref(s.whatsapp, t.whatsapp.message)} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 bg-primary px-6 py-3 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-black">
            WhatsApp <ArrowRight size={14} class="rtl:rotate-180" />
          </a>
          <a href={phoneHref(s.phone)} dir="ltr" class="inline-flex items-center gap-2 border-2 border-black px-6 py-3 text-xs font-black uppercase tracking-wider text-black transition-colors hover:bg-black hover:text-white">
            <Phone size={14} /> {s.phone}
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-neutral-200 bg-white py-14">
      <div class="shell">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-xl font-black uppercase tracking-tight text-neutral-950 sm:text-2xl">{t.services.title} <span class="text-primary">{t.services.accent}</span></h2>
          <span class="text-[11px] font-bold uppercase tracking-wider text-neutral-500">{services.length} {t.services.count}</span>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <a href={href(locale, `/services/${service.slug}/`)} class="group flex flex-col border border-neutral-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-primary hover:shadow-lg">
              <span class="text-[10px] font-black uppercase tracking-[0.16em] text-primary">{t.services.badge}</span>
              <h3 class="mt-2 text-base font-black uppercase leading-tight text-neutral-950 group-hover:text-primary">{service.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-[13px] leading-relaxed text-neutral-600">{service.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-[11px] font-black uppercase tracking-wider text-primary">
                {t.services.more} <ArrowRight size={13} class="rtl:rotate-180" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
