---
import { ArrowRight, FileText, Phone, ShieldCheck, Tag } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import BlogCard from '@/components/BlogCard.astro'
import InternalHero from '@/components/InternalHero.astro'
import { localePaths, localized, locales, phoneHref, settings, siteText, whatsappHref } from '@/lib/i18n'

export const getStaticPaths = localePaths

const { locale } = Astro.props
const t = await siteText(locale)
const s = await settings()
const posts = (await localized('posts', locale)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
const topics = [...new Set(posts.map((post) => post.data.category).filter(Boolean))]
---

<Layout locale={locale} title={t.blog.title} description={t.blog.intro} translated={await locales()}>
  <main class="blog-index">
    <InternalHero locale={locale} eyebrow={t.blog.badge} title={t.blog.title} description={t.blog.intro} breadcrumbTitle={t.nav.blog} />

    <section class="shell" style="padding-top:3.5rem">
      {topics.length > 0 && (
        <div class="mb-10 flex flex-wrap items-center gap-2 border-b border-slate-200 pb-6">
          <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-slate-500 me-2"><Tag size={14} class="text-primary" /> {t.blog.badge}:</span>
          {topics.map((topic) => <span class="inline-flex items-center bg-slate-100 hover:bg-primary hover:text-white px-3 py-1 text-xs font-bold text-slate-700 transition-colors duration-200 cursor-default">{topic}</span>)}
        </div>
      )}

      <div class="blog-intro__inner border-t-4 border-primary bg-[#f8f9fa] p-8 shadow-xs">
        <div class="flex items-center gap-2 text-primary text-xs font-black uppercase tracking-wider"><FileText size={16} /><span>{t.pillars.items[1].title}</span></div>
        <h2 class="text-2xl sm:text-3xl font-black uppercase text-slate-950 tracking-tight">{t.pillars.items[1].subtitle}</h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-3xl">{t.pillars.items[1].text}</p>
      </div>

      <div class="blog-grid mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => <BlogCard locale={locale} post={post} index={index + 1} />)}
      </div>
    </section>

    <section class="dark-band mt-16 bg-[#121820] py-14 text-white">
      <div class="shell dark-band__grid flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-2xl">
          <h3 class="eyebrow flex items-center gap-2 text-xs font-black uppercase tracking-widest text-primary"><ShieldCheck size={18} /> {t.ctaBanner.eyebrow}</h3>
          <h2 class="mt-3 text-2xl sm:text-3xl font-black uppercase text-white tracking-tight">{t.blog.consultTitle}</h2>
          <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">{t.blog.consultText}</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
          <a class="button button--primary inline-flex items-center justify-center gap-2 bg-primary px-6 py-3.5 text-xs font-black uppercase tracking-wider text-white hover:bg-white hover:text-slate-950 transition-colors" href={whatsappHref(s.whatsapp, t.whatsapp.message)} target="_blank" rel="noreferrer">{t.blog.consultAction} <ArrowRight size={16} class="rtl:rotate-180" /></a>
          <a class="button inline-flex items-center justify-center gap-2 border border-white/20 bg-white/10 px-6 py-3.5 text-xs font-black uppercase tracking-wider text-white hover:bg-white hover:text-slate-950 transition-colors" dir="ltr" href={phoneHref(s.phone)}><Phone size={16} /> {s.phone}</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
