---
import { ArrowRight, ChevronDown, ChevronRight, Mail, Menu, Phone, X } from '@lucide/astro'
import Brand from './Brand.astro'
import LanguageSwitcher from '@/components/i18n/LanguageSwitcher.astro'
import { href, localized, menu, menuHref, phoneHref, settings, siteText, whatsappHref } from '@/lib/i18n'
import {
  NavigationMenu,
  NavigationMenuContent,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
  NavigationMenuTrigger,
  navigationMenuTriggerStyle,
} from '@/ui/navigation-menu'

interface Props {
  locale: string
  translated?: string[]
}

const { locale, translated } = Astro.props
const t = await siteText(locale)
const s = await settings()
const services = (await localized('services', locale)).sort((a, b) => a.data.order - b.data.order)

type Item = { label: string; href: string; variant?: 'services'; children?: [string, string][] }
// `type: "services"` opens the services flyout instead of a plain link.
const navItems: Item[] = (await menu(locale, 'header')).map((item) => ({
  label: item.label,
  href: menuHref(locale, item.href),
  variant: item.type === 'services' ? 'services' : undefined,
  children: item.children?.length ? item.children.map((c) => [c.label, menuHref(locale, c.href)] as [string, string]) : undefined,
}))
const serviceHref = (slug: string) => href(locale, `/services/${slug}/`)

const isActive = (url: string) => Astro.url.pathname === url || (url !== href(locale) && Astro.url.pathname.startsWith(url))
---

<header id="site-header" class="sticky top-0 z-50 bg-white group-data-[sticky=true]/header:bg-transparent transition-all duration-300 group/header">
  <div class="hidden lg:block bg-[#111111] text-white border-b border-white/10 group-data-[sticky=true]/header:hidden transition-all duration-200">
    <div class="mx-auto flex min-h-9 w-[95vw] items-center justify-between text-xs px-2">
      <span class="text-white/70 font-medium">{t.topbar}</span>
      <div class="flex items-stretch h-9">
        <a href={phoneHref(s.phone)} dir="ltr" class="inline-flex items-center gap-2 border-l border-white/10 px-4 font-bold text-white/90 hover:text-primary transition-colors text-[11px]"><Phone size={13} /> {s.phone}</a>
        <a href={`mailto:${s.email}`} class="inline-flex items-center gap-2 border-l border-white/10 px-4 font-bold text-white/90 hover:text-primary transition-colors text-[11px]"><Mail size={13} /> {s.email}</a>
        <LanguageSwitcher translated={translated} class="topbar-language border-l border-white/10 px-4 font-bold text-white/90 text-[11px]" />
      </div>
    </div>
  </div>
  <div class="py-2.5 transition-all duration-300">
    <div class="nav-shell mx-auto flex min-h-[4.5rem] w-[95vw] items-center justify-between bg-white px-5 shadow-[0_8px_25px_rgba(0,0,0,0.06)] border border-neutral-200/80 transition-all duration-300 group-data-[sticky=true]/header:bg-[#111111]/95 group-data-[sticky=true]/header:backdrop-blur-md group-data-[sticky=true]/header:border-white/12 group-data-[sticky=true]/header:shadow-2xl">
      <div class="mobile-logo lg:hidden"><Brand locale={locale} /></div>
      <div class="hidden shrink-0 lg:block"><Brand locale={locale} /></div>
      <NavigationMenu class="hidden lg:flex" aria-label={t.nav.home} openOnFocus>
        <NavigationMenuList class="gap-1">
          {navItems.map((item, i) => (
            <NavigationMenuItem value={`nav-${i}`}>
              {item.variant === 'services' ? (
                <>
                  <NavigationMenuTrigger class={isActive(item.href) ? '!border-primary !text-primary !font-black' : ''}>
                    <span>{item.label}</span>
                  </NavigationMenuTrigger>
                  <NavigationMenuContent align="center" class="w-80 bg-white shadow-2xl border border-neutral-200">
                    <div class="grid gap-1 p-2">
                      <span class="px-3 pb-1 pt-2 text-xs font-black uppercase tracking-[.18em] text-primary"><bdi>{s.brand}</bdi></span>
                      <div class="group/sub relative">
                        <NavigationMenuLink href={item.href} class="flex items-center justify-between rounded-sm px-3 py-2.5 text-sm font-black text-black transition-colors hover:bg-primary hover:!text-white">
                          <span class="flex items-center gap-2">{t.services.all} <ChevronRight size={15} class="rtl:rotate-180" /></span>
                        </NavigationMenuLink>
                        <div class="js-flyout invisible absolute start-full top-[-1rem] z-10 w-72 max-h-[400px] overflow-y-auto bg-white opacity-0 shadow-2xl border border-neutral-200 transition-opacity duration-200 group-hover/sub:visible group-hover/sub:opacity-100 group-focus-within/sub:visible group-focus-within/sub:opacity-100 p-2">
                          {services.map((service) => (
                            <NavigationMenuLink href={serviceHref(service.slug)} class="block rounded-sm px-3 py-1.5 text-sm font-semibold text-neutral-900 hover:bg-primary hover:!text-white transition-colors">{service.data.title}</NavigationMenuLink>
                          ))}
                        </div>
                      </div>
                    </div>
                  </NavigationMenuContent>
                </>
              ) : item.children ? (
                <>
                  <NavigationMenuTrigger class={isActive(item.href) ? '!border-primary !text-primary !font-black' : ''}>
                    <span>{item.label}</span>
                  </NavigationMenuTrigger>
                  <NavigationMenuContent class="w-72 sm:w-80 bg-white shadow-2xl border border-neutral-200 [content-visibility:auto]">
                    <div class="grid gap-1 p-2">
                      {item.children.map(([label, url]) => (
                        <NavigationMenuLink href={url} class="block px-3 py-2 text-xs font-bold text-neutral-900 hover:bg-primary hover:!text-white rounded-sm transition-colors">
                          {label}
                        </NavigationMenuLink>
                      ))}
                    </div>
                  </NavigationMenuContent>
                </>
              ) : (
                <NavigationMenuLink href={item.href} class={navigationMenuTriggerStyle({ class: `flex items-center ${isActive(item.href) ? '!border-primary !text-primary !font-black' : ''}` })}>
                  <span>{item.label}</span>
                </NavigationMenuLink>
              )}
            </NavigationMenuItem>
          ))}
        </NavigationMenuList>
      </NavigationMenu>
      <div class="ms-auto flex items-center gap-2 lg:ms-0">
        <a class="inline-flex h-9 sm:h-10 items-center gap-1.5 sm:gap-2 bg-primary px-3 sm:px-3.5 text-[11px] sm:text-xs font-black uppercase tracking-wider text-white shadow-sm transition hover:bg-black" href={href(locale, '/contact/#form')}>
          <span class="grid size-4.5 sm:size-5 place-items-center bg-black text-white"><ArrowRight size={13} class="rtl:rotate-180" /></span> <span>{t.cta}</span>
        </a>
        <a class="icon-button hidden lg:grid size-10 place-items-center border border-neutral-200 text-neutral-900 transition hover:border-primary hover:text-primary group-data-[sticky=true]/header:border-white/20 group-data-[sticky=true]/header:text-white" aria-label={t.contact.phone} href={phoneHref(s.phone)}><Phone size={17} /></a>
      </div>
      <details class="relative lg:hidden group/mobile">
        <summary aria-label="Menu" class="grid size-10 place-items-center cursor-pointer list-none text-neutral-900 group-data-[sticky=true]/header:text-white"><Menu class="group-open/mobile:hidden" size={23} /><X class="hidden group-open/mobile:block" size={23} /></summary>
        <nav aria-label="Menu" class="absolute end-0 top-full mt-2 w-[min(22rem,calc(100vw-2.5rem))] bg-white p-4 sm:p-5 shadow-2xl border border-neutral-200 z-50 text-neutral-900 [content-visibility:auto]">
          <ul class="flex flex-col gap-0.5">
            {navItems.map((item) => (
              <li>
                {item.children || item.variant === 'services' ? (
                  <details class="border-b border-neutral-100 py-1">
                    <summary class="flex items-center justify-between cursor-pointer py-2.5 sm:py-3 text-sm font-bold text-neutral-900 list-none"><span>{item.label}</span><ChevronDown size={17} /></summary>
                    <ul class="ps-2 pt-1.5 pb-2 flex flex-col gap-1">
                      {(item.variant === 'services' ? [[t.services.all, item.href] as [string, string], ...services.map((service) => [service.data.title, serviceHref(service.slug)] as [string, string])] : item.children!).map(([label, url]) => (
                        <li><a class="block px-3 py-2.5 text-xs font-semibold text-neutral-900 hover:bg-primary hover:!text-white rounded-md transition-colors" href={url}>{label}</a></li>
                      ))}
                    </ul>
                  </details>
                ) : <a class="flex items-center justify-between py-3 sm:py-3.5 border-b border-neutral-100 text-sm font-bold text-neutral-900 hover:text-primary transition-colors" href={item.href}><span>{item.label}</span><ArrowRight size={16} class="rtl:rotate-180" /></a>}
              </li>
            ))}
          </ul>
          <LanguageSwitcher translated={translated} class="mt-3 text-sm font-bold" />
          <a class="mt-4 flex items-center justify-between bg-primary p-3.5 text-xs font-black uppercase text-white shadow-sm hover:bg-black transition-colors" href={whatsappHref(s.whatsapp, t.whatsapp.message)} target="_blank" rel="noreferrer">{t.whatsapp.ask} <ArrowRight size={16} class="rtl:rotate-180" /></a>
        </nav>
      </details>
    </div>
  </div>
</header>
