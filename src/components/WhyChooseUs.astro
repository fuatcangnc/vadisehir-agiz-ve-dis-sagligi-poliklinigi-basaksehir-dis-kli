---
import SiteImage from './SiteImage.astro'
import { siteText } from '@/lib/i18n'

interface Props {
  locale: string
}

const t = await siteText(Astro.props.locale)
const featuresLeft = t.why.features.slice(0, 2)
const featuresRight = t.why.features.slice(2, 4)
---

<section class="relative bg-white py-20 lg:py-28 overflow-hidden" id="why-us">
  <div class="shell">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-block">
        <span class="inline-block -skew-x-12 bg-primary px-5 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-white">
          <span class="inline-block skew-x-12">{t.why.badge}</span>
        </span>
      </div>
      <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-black leading-tight">{t.why.title}</h2>
      <p class="mt-4 text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto leading-relaxed font-normal">{t.why.text}</p>
    </div>

    <div class="why-us-grid mt-14 lg:mt-18 grid grid-cols-1 lg:grid-cols-12 items-center gap-8 lg:gap-4">
      <div class="lg:col-span-3 flex flex-col gap-8 order-2 lg:order-1">
        {featuresLeft.map((feat) => (
          <div class="why-feat-left relative border-s-4 border-primary ps-5 py-2 group opacity-0 will-change-transform">
            <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-black group-hover:text-primary transition-colors">{feat.title}</h3>
            <p class="mt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">{feat.text}</p>
          </div>
        ))}
      </div>

      <div class="why-car-center lg:col-span-6 flex items-center justify-center order-1 lg:order-2 opacity-0 will-change-transform">
        <div class="relative w-full max-w-[720px] aspect-[16/10] overflow-hidden [clip-path:polygon(0_0,100%_0,100%_92%,94%_100%,0_100%)]">
          <SiteImage src="/images/team.webp" alt="" class="size-full object-cover pointer-events-none select-none" loading="lazy" widths={[480, 720]} sizes="(min-width: 1024px) 50vw, 100vw" width="720" height="450" />
        </div>
      </div>

      <div class="lg:col-span-3 flex flex-col gap-8 order-3">
        {featuresRight.map((feat) => (
          <div class="why-feat-right relative border-s-4 lg:border-s-0 lg:border-e-4 border-primary ps-5 lg:ps-0 lg:pe-5 py-2 lg:text-end group opacity-0 will-change-transform">
            <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-black group-hover:text-primary transition-colors">{feat.title}</h3>
            <p class="mt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">{feat.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="why-us-stats mt-16 lg:mt-24 pt-12 border-t border-neutral-200 grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-10">
      {t.why.stats.map((stat) => (
        <div class="flex flex-col items-center text-center group">
          <div class="flex items-baseline justify-center text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black group-hover:text-primary transition-colors" dir="ltr">
            <span class="countup-num" data-target={stat.value}>{stat.value}</span>
            {stat.suffix && <span class="text-primary ms-0.5">{stat.suffix}</span>}
          </div>
          <div class="mt-2 w-8 h-0.5 bg-primary group-hover:w-14 transition-all duration-300"></div>
          <h4 class="mt-3 text-xs sm:text-sm font-black uppercase tracking-wider text-black">{stat.label}</h4>
          <p class="mt-1 text-xs text-neutral-600 max-w-[13rem] leading-relaxed">{stat.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
