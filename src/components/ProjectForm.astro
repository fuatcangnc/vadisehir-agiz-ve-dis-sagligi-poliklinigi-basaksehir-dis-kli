---
import { ArrowRight, CircleCheck, Lock, Zap } from '@lucide/astro'
import { localized, settings, siteText } from '@/lib/i18n'

interface Props { locale: string; title?: string; hideHeading?: boolean }
const { locale, hideHeading = false } = Astro.props
const t = await siteText(locale)
const s = await settings()
const title = Astro.props.title ?? t.form.title
const services = (await localized('services', locale)).sort((a, b) => a.data.order - b.data.order)
const field = 'w-full border border-neutral-300 bg-neutral-50/50 px-4 py-3 text-sm font-semibold text-neutral-900 placeholder:text-neutral-400 placeholder:font-normal outline-none transition focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary'
const label = 'grid gap-1.5 text-[11px] font-black uppercase tracking-wider text-neutral-800'
---

<div class="relative w-full border border-neutral-300 bg-white p-6 sm:p-10 shadow-lg text-neutral-950">
  <div class="absolute inset-x-0 top-0 h-1.5 bg-primary"></div>

  <form class="grid w-full gap-5" data-project-form data-whatsapp={s.whatsapp} data-heading={`${t.form.heading} · ${s.brand}`} data-labels={JSON.stringify([t.form.name, t.form.phone, t.form.company, t.form.service, t.form.details])}>
    {!hideHeading && (
      <div class="grid gap-1.5 pb-4 border-b border-neutral-200">
        <span class="text-[11px] font-black uppercase tracking-[.18em] text-primary">{t.form.eyebrow}</span>
        <h2 class="text-2xl font-black uppercase tracking-tight text-neutral-950">{title}</h2>
        <p class="text-xs text-neutral-600 leading-relaxed">{t.form.text}</p>
      </div>
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      <label class={label}>
        {t.form.name} *
        <input class={field} required name="fullName" autocomplete="name" placeholder={t.form.namePlaceholder} />
      </label>
      <label class={label}>
        {t.form.phone} *
        <input class={field} required name="phone" autocomplete="tel" inputmode="tel" dir="ltr" />
      </label>
      <label class={label}>
        {t.form.company}
        <input class={field} name="company" autocomplete="organization" placeholder={t.form.companyPlaceholder} />
      </label>
      <label class={label}>
        {t.form.service}
        <select class={field} name="service">
          <option value="">{t.form.choose}</option>
          {services.map((service) => <option value={service.data.title}>{service.data.title}</option>)}
        </select>
      </label>
      <label class={`${label} sm:col-span-2`}>
        {t.form.details}
        <textarea class={`min-h-24 resize-y ${field}`} name="details" rows="3" placeholder={t.form.detailsPlaceholder}></textarea>
      </label>
    </div>

    <label class="flex items-start gap-2.5 text-xs leading-relaxed text-neutral-600 cursor-pointer select-none">
      <input class="mt-0.5 size-4 rounded-none accent-primary" required type="checkbox" name="consent" />
      <span>{t.form.consent}</span>
    </label>

    <button class="group inline-flex min-h-13 w-full items-center justify-center gap-3 bg-neutral-950 hover:bg-primary text-white font-black uppercase text-xs sm:text-sm tracking-wider px-8 py-4 transition-all duration-300 shadow-md hover:shadow-primary/30" type="submit">
      <span>{t.form.send}</span>
      <ArrowRight class="size-4 group-hover:translate-x-1 transition-transform rtl:rotate-180" />
    </button>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 pt-4 text-[11px] font-bold text-neutral-500">
      <span class="inline-flex items-center gap-1.5"><Lock class="size-3.5 text-emerald-600" /> {t.form.safe}</span>
      <span class="inline-flex items-center gap-1.5 text-primary"><Zap class="size-3.5" /> {t.form.reply}</span>
    </div>

    <p class="flex items-center gap-2 border border-emerald-300 bg-emerald-50 p-3 text-xs font-bold text-emerald-800" data-form-status hidden>
      <CircleCheck size={18} class="text-emerald-600 shrink-0" />
      <span>{t.form.sent}</span>
    </p>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-project-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const data = new FormData(form)
      const labels: string[] = JSON.parse(form.dataset.labels ?? '[]')
      const values = ['fullName', 'phone', 'company', 'service', 'details'].map((name) => data.get(name) || '-')
      const message = [`*${form.dataset.heading}*`, ...labels.map((label, i) => `${label}: ${values[i]}`)].join('\n')
      form.querySelector('[data-form-status]')?.removeAttribute('hidden')
      window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer')
    })
  })
</script>
